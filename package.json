{
  "name": "xilore-uptime",
  "version": "2.4.0",
  "description": "简洁的网站监控工具 - 支持 HTTP、TCP 端口和 ICMP Ping 检测",
  "type": "module",
  "main": "dist/server/server.js",
  "author": "Luminous",
  "license": "Luminous License",
  "keywords": [
    "uptime",
    "monitor",
    "http",
    "tcp",
    "ping",
    "website-monitor",
    "monitoring"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:public",
    "build:server": "tsc",
    "build:public": "node scripts/build-public.mjs",
    "start": "node dist/server/server.js",
    "dev": "tsx server/server.ts",
    "test:ui-dev": "tsx tests/ui-dev-mode.test.ts",
    "test:communications": "node --import tsx --test tests/communications.test.ts tests/group-status.test.ts tests/history-chart.test.ts tests/response-stats.test.ts",
    "test:version": "tsx tests/xil-version.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "markdown-it": "^15.0.2",
    "mysql2": "^3.9.1",
    "nodemailer": "7.0.11",
    "xilore-log4js": "^1.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "esbuild": "^0.28.1",
    "javascript-obfuscator": "^4.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
